{
  "name": "cyber-monshin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test --grep-invert @paid",
    "test:e2e:paid": "E2E_PAID=1 playwright test",
    "eval": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env eval/run.ts",
    "eval:terms": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env eval/terms.ts",
    "check:safety": "node scripts/check-public-safety.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "next typegen && tsc --noEmit",
    "eval:clerk": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env eval/clerk.ts",
    "eval:perf": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env eval/perf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@digital-go-jp/tailwind-theme-plugin": "^2.0.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@playwright/mcp": "^0.0.84",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "playwright": "1.65.0-alpha-2026-10-30",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
